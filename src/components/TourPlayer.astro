  },
  {
    "t": 1212,
    "label": "20:12",
    "name": "Lagrange"
  }
]
---
<video id="tour" controls preload="metadata" playsinline poster={base + '/video/lagrange-tour.jpg'} src={base + '/video/lagrange-tour.mp4'}></video>
<ol class="tour-chapters">
  {chapters.map((c) => <li><button type="button" data-t={c.t}><code>{c.label}</code> {c.name}</button></li>)}
</ol>
<script>
  const v = document.getElementById('tour') as HTMLVideoElement
  document.querySelectorAll<HTMLButtonElement>('.tour-chapters button').forEach((b) => {
    b.addEventListener('click', () => { v.currentTime = Number(b.dataset.t); v.play() })
  })
</script>
<style>
  video { width: 100%; border-radius: 12px; background: #121418; }
  .tour-chapters { columns: 2; list-style: none; padding: 0; margin-top: 1rem; }
  .tour-chapters button { all: unset; cursor: pointer; padding: 0.2rem 0; }
  .tour-chapters button:hover { text-decoration: underline; }
  @media (max-width: 600px) { .tour-chapters { columns: 1; } }
</style>
